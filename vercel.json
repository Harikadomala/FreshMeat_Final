
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "admin_portal": {
      "root": "Admin_Portal",
      "entrypoint": "app:app"
    },
    "customer_portal": {
      "root": "Customer_Portal",
      "entrypoint": "app:app"
    },
    "rider_portal": {
      "root": "Rider_Portal",
      "entrypoint": "app:app"
    },
    "seller_portal": {
      "root": "Seller_Portal",
      "entrypoint": "seller:app"
    }
  },
  "rewrites": [
    {
      "source": "/admin/static/(.*)",
      "destination": {
        "service": "admin_portal",
        "path": "admin/static/$1"
      }
    },
    {
      "source": "/admin",
      "destination": {
        "service": "admin_portal",
        "path": "/admin"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "admin_portal",
        "path": "/admin/$1"
      }
    },
    {
      "source": "/rider",
      "destination": {
        "service": "rider_portal",
        "path": "/"
      }
    },
    {
      "source": "/rider/(.*)",
      "destination": {
        "service": "rider_portal",
        "path": "/$1"
      }
    },
    {
      "source": "/seller",
      "destination": {
        "service": "seller_portal",
        "path": "/"
      }
    },
    {
      "source": "/seller/(.*)",
      "destination": {
        "service": "seller_portal",
        "path": "/$1"
      }
    },
    {
      "source": "/api/seller",
      "destination": {
        "service": "seller_portal",
        "path": "/api/seller"
      }
    },
    {
      "source": "/api/seller/(.*)",
      "destination": {
        "service": "seller_portal",
        "path": "/api/seller/$1"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "customer_portal"
      }
    }
  ]
}
